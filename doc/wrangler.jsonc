{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zudo-blanks",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // No production activation occurs during CI, local dev, or a dry run.
  "env": {
    "production": {
      "name": "zudo-blanks",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "zudo-blanks.zudolab.dev", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page"
      }
    }
  }
}
