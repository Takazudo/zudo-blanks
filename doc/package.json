{
  "name": "zudo-blanks-doc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "run-parallel dev:zfb dev:history",
    "build": "node scripts/reconcile-history.mjs --metadata && GEN_DOC_HISTORY=1 zfb build && node scripts/reconcile-history.mjs",
    "preview": "zfb preview",
    "check": "node scripts/reconcile-history.mjs --metadata && zfb check",
    "check:links": "node scripts/check-links.js",
    "check:images": "zudo-doc check images",
    "dev:zfb": "node scripts/reconcile-history.mjs --metadata && zfb dev",
    "dev:zfb:network": "node scripts/reconcile-history.mjs --metadata && zfb dev --host 0.0.0.0",
    "dev:network": "run-parallel dev:zfb:network dev:history",
    "dev:history": "doc-history-server --port 4322 --content-dir src/content/docs",
    "prepare:content": "python3 scripts/generate_panel_catalog.py",
    "check:content": "python3 scripts/generate_panel_catalog.py --check && python3 scripts/check_panel_catalog.py",
    "check:accessories": "node scripts/check-printable-accessories.mjs",
    "prepare:viewers": "node scripts/stage_viewers.mjs",
    "check:viewers": "node scripts/stage_viewers.mjs --check",
    "prepare:redirects": "node scripts/redirects.mjs",
    "check:redirects": "node scripts/redirects.mjs --check",
    "check:worker": "node scripts/check-worker.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:history": "node scripts/reconcile-history.mjs --metadata --check && node scripts/reconcile-history.mjs --check"
  },
  "dependencies": {
    "@takazudo/zfb": "4.3.2",
    "@takazudo/zfb-runtime": "4.3.2",
    "@takazudo/zfb-md-wasm": "4.3.2",
    "@takazudo/zudo-doc": "6.0.2",
    "zod": "^4.3.6",
    "diff": "^8.0.3",
    "@takazudo/zudo-doc-history-server": "6.0.2",
    "@takazudo/zfb-adapter-cloudflare": "4.3.2"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@10.28.1"
}
